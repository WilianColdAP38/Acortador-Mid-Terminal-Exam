# Copia este archivo como .env y completa los valores reales.
# El archivo .env nunca se sube al repositorio.
# No van llaves de AWS: la EC2 usa el IAM Role acortador-ec2-dynamodb-role.

AWS_REGION=us-east-1
DYNAMODB_TABLE=acortador-links

# Dirección pública de la API; con ella se arma la short_url
PUBLIC_BASE_URL=http://<elastic-ip>:8000

# Orígenes que pueden llamar a la API, separados por coma
CORS_ORIGINS=http://acortador-frontend-wc38.s3-website-us-east-1.amazonaws.com,http://localhost:5500
