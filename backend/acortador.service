[Unit]
Description=API del acortador de enlaces (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/acortador/backend
EnvironmentFile=/home/ubuntu/acortador/backend/.env
ExecStart=/home/ubuntu/acortador/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
